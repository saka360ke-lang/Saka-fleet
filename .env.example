# ============================================================
# SAKA FLEET - ENVIRONMENT TEMPLATE (.env.example, v1.14.2)
# Copy to .env and fill in real values. Keep sections in this
# order so AI routing, telemetry and provider settings stay
# auditable. Kill switches stay OFF in this template.
# ============================================================

# ============================================================
# SERVER
# ============================================================
PORT=8080
# Public base for short links (report PDFs, checkout links). Optional.
# Default base is https://app.sakafleet.com (the Cloud Run custom domain).
PUBLIC_APP_URL=https://app.sakafleet.com
# v1.32.2 — short links only ship after the branded domain serves HTTPS.
# Verified live 2026-11-02 (https://app.sakafleet.com/r/__saka_probe__ answers).
SHORT_LINK_DOMAIN_READY=on
# v1.39.0 — browser origins allowed to call /api/onboard* and /healthz from the
# marketing site. Comma-separated; localhost is always allowed for development.
# LANDING_ORIGINS=https://sakafleet.com,https://www.sakafleet.com
# v1.74.0 — Phase 13 web dashboard (magic link + email OTP + session cookie).
# OFF by default: while off, every /d route answers a generic 404 and the
# WhatsApp "dashboard" lane answers as unavailable. Set on only after the
# dashboard program is proven on the live revision.
# DASHBOARD_ENABLED=off

# ============================================================
# SUPERADMIN
# Only this E.164 WhatsApp number may run admin commands
# (type "adminstart" first; sessions expire after 30 minutes).
# ============================================================
SUPERADMIN_PHONE=+254700000000
SUPERADMIN_EMAIL=admin@example.com

# ============================================================
# SUPABASE (PostgreSQL + PostgREST)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional: management/SQL access (schema migrations + DDL bootstrap).
SUPABASE_ACCESS_TOKEN=

# ============================================================
# PAYMENTS - PAYSTACK
# ============================================================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=https://sakafleet.com/payment-success
# Public pricing page used as a checkout fallback in WhatsApp copy.
PUBLIC_PRICING_URL=https://sakafleet.com/pricing

# ---- SUBSCRIPTIONS & TRIALS (v1.15.0) ----
# One-time account trial length in days (clamped 7-90).
TRIAL_DAYS=30
# Cumulative trial cap including extension coupons (>= TRIAL_DAYS).
TRIAL_MAX_TOTAL_DAYS=45
# v1.61.16 — the trial never caps the garage; this is an anti-abuse ceiling only
# (default 50, 0 = unlimited). At trial end a bounded decision window opens.
TRIAL_MAX_ASSETS=50
# Days the "choose your plan" window stays open after the trial ends
# (0-14; default 7; 0 restores the old instant downgrade to Free).
TRIAL_END_GRACE_DAYS=7
# Activation reward coupon: % off the first paid cycle (0 disables).
TRIAL_ACTIVATION_COUPON_PCT=20
TRIAL_ACTIVATION_COUPON_TTL_DAYS=7
# Nudge un-activated trials after N hours (default 7 days).
TRIAL_ACTIVATION_NUDGE_HOURS=168
# Optional declining discount ladder (off by default).
TRIAL_CONVERSION_LADDER=on
TRIAL_MIDPOINT_COUPON_PCT=15
# Entitlement cache TTL (ms) and PAST_DUE grace window (days).
SUBSCRIPTION_CACHE_MS=60000
SUBSCRIPTION_GRACE_DAYS=3
# Recurring Paystack plan codes: one per tier x interval x currency.
# Tier keys: SOLO_PRO | TEAM_FLEET | GROWTH | FLEET_COMMAND
# Intervals: MONTHLY | ANNUAL   Currencies: USD | KES | NGN | ZAR
# Leave a code blank to fall back to one-time checkout (webhook still activates).
# PAYSTACK_PLAN_SOLO_PRO_MONTHLY_USD=
# PAYSTACK_PLAN_TEAM_FLEET_ANNUAL_KES=
# PAYSTACK_PLAN_GROWTH_MONTHLY_USD=
# PAYSTACK_PLAN_FLEET_COMMAND_ANNUAL_USD=

# ---- LAUNCH CAMPAIGN (v1.58.26; 6-month offer v1.61.0) ----
# The launch award: the FIRST N accounts that start their welcome trial get a
# long card-free trial instead of TRIAL_DAYS. Slot N+1 and everyone after keeps
# the normal welcome flow (automatic fallback — nothing to switch off).
# Kill switch: off hides the website banner AND refuses new awards.
LAUNCH_AWARD_ENABLED=on
LAUNCH_MAX_FIRST_SIGNUPS=50
# 6 months. Clamped 30-183: no value can extend the offer past 6 months.
LAUNCH_AWARD_DAYS=183
# Cache TTL for the public /api/onboard/launch-status lookup (ms, 5s-10min).
LAUNCH_STATUS_CACHE_MS=60000

# ============================================================
# MESSAGING - META WHATSAPP CLOUD API
# ============================================================
META_PHONE_NUMBER_ID=123456789012345
META_WHATSAPP_TOKEN=EAAG-your-whatsapp-token
META_VERIFY_TOKEN=choose-a-verify-token
# IMPORTANT: use the REAL App Secret (Meta App settings -> Basic -> App secret).
# The test placeholder (meta_app_secret_sakafleet_2026) is only valid inside
# test_security.js â€” if it reaches Cloud Run, EVERY inbound webhook returns 403.
# Boot logs print "[ENV] META_APP_SECRET: set (len N)" (masked) to prove parity.
META_APP_SECRET=your-meta-app-secret
# v1.39.0 — optional Meta-approved template name for the web-signup welcome
# (business-initiated message). Leave blank: the website's wa.me deep link and
# Saka's first-message greeting carry the welcome instead.
# META_WELCOME_TEMPLATE_NAME=web_signup_welcome
#
# v1.63.0 - proactive template registry (sec 182). Business-initiated messages
# (reminders, trial nudges, dunning, winback, re-engagement, driver release,
# deploy LIVE, eval digest ping, care escalation) deliver OUTSIDE Meta's
# 24-hour window ONLY through an approved template. Each knob takes the exact
# approved template name (docs/TEMPLATES.md lists the bodies to submit).
# Unset (default) = today's free-form text, byte-identical behaviour.
# META_TPL_SERVICE_REMINDER=
# META_TPL_EXPIRY_REMINDER=
# META_TPL_TRIAL_ENDING=
# META_TPL_TRIAL_GRACE=
# META_TPL_DUNNING=
# META_TPL_RE_ENGAGEMENT=
# META_TPL_DRIVER_UNASSIGNED=
# META_TPL_WINBACK=
# META_TPL_DEPLOY_LIVE=
# META_TPL_EVAL_DIGEST_PING=
# META_TPL_CARE_ESCALATION=
# META_TPL_DRIVER_ACTIVITY=
# META_TPL_FLEET_AUTO_AUDIT=

# ============================================================
# EMAIL - RESEND
# ============================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbound support email (Resend inbound) webhook gate. When set, POST
# /webhook/email/inbound requires the header `x-saka-inbound: <secret>`.
# EMAIL_INBOUND_SECRET=your-inbound-secret
# Resend webhook signing secret (whsec_...). Preferred: verifies the
# svix-id / svix-timestamp / svix-signature headers on every inbound email.
# EMAIL_INBOUND_SIGNING_SECRET=whsec_your_signing_secret
# WhatsApp number of the customer-care worker who tends support@reports.sakafleet.com.
# Falls back to SUPERADMIN_PHONE when unset.
# CUSTOMER_CARE_PHONE=+254700000000
# Care worker display name used on replies (optional).
# CUSTOMER_CARE_NAME=Saka Care
# Email follow-ups from the same sender + subject append to the open ticket
# inside this window instead of opening a new one (hours, default 168 = 7 days).
# CARE_THREAD_WINDOW_HOURS=168
# Upper bound of tickets scanned by `care stats` / the inbox (default 200).
# CARE_TICKET_MAX_OPEN=200
# Identical errors (same route + message) are logged once per this window to keep
# error_logs signal-rich (hours, default 24).
# ERROR_ROLLUP_HOURS=24

# ============================================================
# OCR - GOOGLE CLOUD VISION
# ============================================================
GCP_VISION_API_KEY=AIzaSy-your-vision-key
# Media + confirmation guard rails (defaults shown).
# OCR_MAX_MEDIA_BYTES=5242880
# OCR_TIMEOUT_MS=15000
# OCR_VISION_TIMEOUT_MS=25000
# OCR_VISION_MAX_ATTEMPTS=2
# OCR_PDF_MAX_PAGES=20
# v1.28.8 — Vision photo OCR is ON by default during the testing phase.
# PDFs are ALWAYS read locally (fast, no provider). Set to off|false|0 to pause;
# ack-first keeps replies instant while the read finishes.
OCR_ENABLED=on
OCR_ACK_FIRST=on
# Quiz upload hints (send a photo of the pending document) default ON when OCR is on.
UPLOAD_HINTS_ENABLED=on
# OCR_CONFIRM_THRESHOLD=0.85
# v1.32.1 — duplicate protection (content hash window + expense write guard).
# OCR_DUPLICATE_WINDOW_HOURS=48
# OCR_EXPENSE_DEDUPE_HOURS=3
# v1.54.1 — zero-shot AI top-up fills fields the deterministic Document Lens
# missed (background router tier, deterministic always wins). Default OFF
# during the testing phase; on|true|1 enables it.
# OCR_AI_EXTRACTION=off
# Supabase Storage bucket for original receipt images (optional).
# RECEIPTS_BUCKET=receipts
# v1.58.15 - document retention: 0 (default) keeps receipts and images forever
# (tax evidence); set a day count to prune old ones. OCR telemetry defaults to 90 days.
# RECEIPT_RETENTION_DAYS=0
# OCR_TELEMETRY_RETENTION_DAYS=90
# v1.79.0 — VOICE NOTES (Google Cloud Speech-to-Text, same GCP project as Vision).
# Operator: enable "Cloud Speech-to-Text API" in the GCP console and allow it on
# this key's API restrictions (or set a dedicated key below). Voice notes are
# transcribed and processed exactly like typed messages (≤55 s / 5 MB).
# GCP_SPEECH_API_KEY=AIzaSy-your-speech-key
# GCP_SPEECH_ENDPOINT=https://speech.googleapis.com/v1/speech:recognize
# STT_ENABLED=on
# Sync recognizer caps at 60 s — 55 s keeps a safety margin (clamped 5-60).
# STT_MAX_DURATION_SECONDS=55
# STT_ESTIMATED_BITRATE=16000
# STT_TIMEOUT_MS=25000
# STT_MAX_ATTEMPTS=2
# FEATURE_NOTICE_VERSION: once-only "What's new" digest version stamp per profile.
# Bump on release; existing users see the digest once on their next normal turn.
FEATURE_NOTICE_VERSION=1.20.0

# ============================================================
# COUNTRY KB INGEST (v1.21.1) - official-source drafts only
# ============================================================
# KB_MAX_SOURCE_BYTES=2000000
# KB_FETCH_TIMEOUT_MS=20000

# ============================================================
# AI ROUTER (src/services/aiClient.js) - single LLM hub
# All traffic is purpose-tagged; see SAKA_FLEET_ARCHITECTURE.md
# sections 36-38.
# ============================================================

# ---- MASTER KILL SWITCHES ----
# PREMIUM_MODEL_ENABLED: off|on -> Tier-2 premium routing (Anthropic primary, OpenAI failover).
# Default off: every Tier-2 purpose downgrades to Tier-1 DeepSeek.
PREMIUM_MODEL_ENABLED=off
# PREMIUM_MODEL_MODE: all|escalate -> 'all' (default) applies the plan floor and
# the PURPOSE_TIER_OVERRIDES caps: paid/live-trial turns run Sonnet except the
# mechanical purposes (question_render/stall_nudge/small_talk), which stay on
# Haiku on every plan; 'escalate' restores the legacy canary WITHOUT per-purpose
# caps (simple turns stay Tier 1).
# PREMIUM_MODEL_MODE=all
# AI_USAGE_LOGGING_ENABLED: on|off -> ai_usage_logs telemetry writes.
AI_USAGE_LOGGING_ENABLED=on

# ---- TIER & PROVIDER CONFIGURATION ----
# Tier 1 = router/utility (DeepSeek). Tier 2 = conversational nuance. Tier 3 = reasoning (background only).
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Required only when CONVERSATIONAL_PROVIDER=anthropic (fetch-based Messages API).
ANTHROPIC_API_KEY=
CONVERSATIONAL_PROVIDER=deepseek
# Tier-2 failover uses TWO provider-correct model slots (see section 38):
#   AI_MODEL_TIER_2        = PRIMARY conversational model. Recommended:
#                            claude-sonnet-5-5 (best speed + intelligence).
#                            Requires CONVERSATIONAL_PROVIDER=anthropic and
#                            PREMIUM_MODEL_ENABLED=on.
#   AI_MODEL_TIER_2_OPENAI = SECONDARY failover model (OpenAI GPT-4o). Used only when
#                            the primary leg fails AND OPENAI_API_KEY is configured.
# Chain order: anthropic -> openai -> deepseek (DeepSeek is always terminal).
AI_MODEL_TIER_2=claude-sonnet-5-5
# Optional overrides (defaults shown):
AI_MODEL_TIER_1=deepseek-chat
# v1.23.0 Tier-1 (front conversations) - Sonnet-first when a key exists.
# AI_TIER1_PROVIDER=anthropic
# AI_MODEL_TIER_1_ANTHROPIC=claude-haiku-4-5
AI_MODEL_TIER_3=deepseek-chat
# Newer Claude models (Sonnet 5.5+) reject `temperature`; leave off.
# Set to on only for legacy Anthropic models that still accept it.
# ANTHROPIC_TEMPERATURE_SUPPORTED=off
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=

# ---- TELEMETRY & RETENTION ----
# AI_USAGE_LOG_MAX_ROWS: hard retention cap for ai_usage_logs.
# AI_USAGE_TRIM_EVERY: writes between retention sweeps.
AI_USAGE_LOG_MAX_ROWS=10000
AI_USAGE_TRIM_EVERY=250

# ---- DEEPSEEK OFF-PEAK SCHEDULING (v1.62.0, rule 61) ----
# DeepSeek bills peak rates Mon-Fri 01:00-04:00 & 06:00-10:00 UTC (04:00-07:00 &
# 09:00-13:00 EAT); every other hour — weekends and Chinese public holidays
# included — is half price. Heavy batch CLIs (npm run synth:cases,
# npm run eval:conv) refuse to start during peak and print the exact next
# off-peak time; --force overrides one run (audited DEEPSEEK_DEFERRED_TO_OFF_PEAK).
# DEEPSEEK_OFF_PEAK_GATE=on
# Off-peak price multiplier used by telemetry cost estimates (default 0.5).
# DEEPSEEK_OFF_PEAK_DISCOUNT_FACTOR=0.5
# Extra Chinese public holidays (Beijing dates) DeepSeek treats as fully
# off-peak; lunar festivals move yearly, so add them from the official State
# Council notice. CSV of YYYY-MM-DD. Built-in fixed windows: Jan 1, Apr 4-6,
# May 1-5, Oct 1-7.
# DEEPSEEK_CN_HOLIDAYS=

# ---- TIMEOUT & CONCURRENCY ----
# AI_TIMEOUT_MS: fail-fast timeout for Tier-1 calls (Tier 3 uses AI_TIMEOUT_MS_REASONING).
# AI_TIMEOUT_MS_PREMIUM: Tier-2 premium-leg timeout (Anthropic or OpenAI).
# AI_PREMIUM_MAX_CONCURRENCY: Anthropic in-flight cap; overflow falls to the next leg.
AI_TIMEOUT_MS=12000
AI_TIMEOUT_MS_PREMIUM=30000
AI_PREMIUM_MAX_CONCURRENCY=8
# v1.24.2 — fallback/chain budgets: a slow primary gets the premium budget, but
# secondary legs and the overall premium chain are capped so a multi-provider
# outage can never turn one AI call into a two-minute wait.
# AI_TIMEOUT_MS_FALLBACK=10000
# AI_CHAIN_BUDGET_MS=45000
# v1.22.0 — quiz questions cap faster (deterministic template renders as fallback).
# AI_TIMEOUT_MS_QUESTION=10000
# Empty retries only fire when the first attempt failed fast (avoids double waits).
# EMPTY_RETRY_MAX_FIRST_MS=5000

# ---- FAILOVER, CIRCUIT BREAKERS & BUDGET ----
# Failover chain: anthropic -> openai -> deepseek (keys decide which legs are live).
# DeepSeek is always the terminal leg and is never skipped or breaker-blocked (section 38).
# Circuit breakers are per provider; DeepSeek is never breaker-blocked.
AI_CB_FAILURE_THRESHOLD=3
AI_CB_WINDOW_MS=60000
AI_CB_OPEN_MS=30000
# v1.24.2 — billing/auth failures (no credits, revoked key, unpaid account) trip
# the breaker on the FIRST failure and for much longer than a transient hiccup.
# AI_CB_BILLING_OPEN_MS=1800000
# Tier-3 provider (deepseek | anthropic) and reasoning timeout (background only).
AI_REASONING_PROVIDER=deepseek
AI_TIMEOUT_MS_REASONING=45000
# Secondary Tier-2 failover model (OpenAI GPT-4o). Used only when the primary leg
# fails AND OPENAI_API_KEY is set. Primary = AI_MODEL_TIER_2 (Sonnet when provider=anthropic).
AI_MODEL_TIER_2_OPENAI=gpt-4o
# Daily spend guardrail (approx list prices). 0 or unset = disabled.
AI_DAILY_BUDGET_USD=0
# First budget alert threshold; 100% always alerts (deduped per day).
AI_BUDGET_ALERT_PCT=80

# ============================================================
# ============================================================
# MODEL WATCHDOG (v1.17.0)
# Weekly model discovery + deterministic benchmark + canary adoption.
# Kill switches stay OFF in this template; never enable silently.
# ============================================================
# Model Scout: weekly provider /models discovery + benchmark (default off).
AI_MODEL_SCOUT_ENABLED=off
# Auto-adopt may ONLY start a canary (<= AI_MODEL_MAX_CANARY_PCT); full adoption
# always requires the Superadmin ("admin model adopt" / "admin accept fix <CODE>").
AI_MODEL_AUTO_ADOPT=off
# Web search/fetch research leg (capability-gated; default off).
AI_WEB_SEARCH_ENABLED=off
# Discovery cadence (hours) and per-run benchmark cap.
AI_MODEL_SCOUT_INTERVAL_HOURS=168
AI_MODEL_SCOUT_MAX_BENCHMARKS_PER_RUN=2
# Adoption threshold (0-1) and canary ceiling (%).
AI_MODEL_MIN_BENCHMARK_SCORE=0.85
AI_MODEL_MAX_CANARY_PCT=25
# Health watchdog: auto-rollback when the active model regresses vs standby.
AI_MODEL_HEALTH_WINDOW_HOURS=24
AI_MODEL_ROLLBACK_MIN_SAMPLES=30
AI_MODEL_ROLLBACK_ERROR_RATE=3
AI_MODEL_ROLLBACK_ABSOLUTE_ERROR_RATE=0.25
# Runtime registry cache refresh (ms; env overrides always win).
AI_MODEL_RUNTIME_CACHE_MS=120000


# SENTINEL & AUTONOMOUS REMEDIATION
# ============================================================
# Shared secret for the Sentinel endpoint.
SENTINEL_SECRET=your-sentinel-secret
# Sentinel may DETECT but never offers proposals by default (v1.58.14).
# off = findings go to chat_friction_logs for a human; on = legacy PROP minting.
SENTINEL_PROPOSALS_ENABLED=off

# Execution kill switch: off|on. Default off - never enable silently.
REMEDIATION_AUTONOMY=off
GH_REMEDIATION_TOKEN=ghp_your-github-token
GH_REMEDIATION_REPO=owner/repository

# Growth & recovery ladders (v1.28.8; defaults shown)
# Abandoned checkout: fire after N minutes, cap total reminders per link.
# CHECKOUT_ABANDONED_AFTER_MIN=30
# CHECKOUT_REMINDER_MAX=3
# Post-expiry benefit nudges (D+7 / D+30; D+15 winback rides the same worker).
# RENEWAL_NUDGE_MAX=3
# Country communication style cache + always-on self-learning tick.
# COMM_STYLE_CACHE_MS=600000
# COUNTRY_LEARNINGS_CACHE_MS=600000
# WELCOME_TRIAL_TIER=growth
# SENTINEL_LEARN_INTERVAL_MS=900000
# v1.55.1 — conversational response-mismatch diagnosis: Sentinel asks the
# reasoning tier to inspect the routing map and draft a PROP-* proposal
# (PENDING_APPROVAL) when a reply missed the ask. Read-only, default OFF.
# CONVERSATION_DIAGNOSIS_ENABLED=off

# v1.58.5 — bi-weekly Sentinel deep audit: a deterministic code-integrity scan
# (mojibake, Africa/Nairobi time, ledger scoping, recurring error_logs) that mints
# PENDING_APPROVAL PROP-* proposals for human review. Never edits code. Default ON.
# Cadence format: <days>@HH:MM (Africa/Nairobi). Mon & Thu @ 03:00 by default.
# SENTINEL_DEEP_AUDIT_ENABLED=on
# SENTINEL_DEEP_AUDIT_SCHEDULE=Mon,Thu@03:00

# v1.60.0 / v1.61.3 — DeepEval-style conversation evals (judge + healing).
# The judge scores real replies (live chat exchanges + offline corpus + live
# friction transcripts) on loop avoidance, tone, shorthand precision,
# one-question and boundary safety. Default OFF in the template; production
# enables it explicitly (documented in SAKA_FLEET_ARCHITECTURE.md §168).
# CONV_EVAL_ENABLED=off
# Tick cadence in MINUTES (5-360; default 15). CONV_EVAL_INTERVAL_HOURS still
# works when set (1-168 h) and wins only if the minutes knob is absent.
# CONV_EVAL_INTERVAL_MINUTES=15
# Legacy hours knob (1-168 h) still works when the minutes knob is absent.
# CONV_EVAL_INTERVAL_HOURS=6
# Cases per tick/run. 0 = NO LIMIT (every live exchange + the full corpus,
# bounded only by provider resources). Default 100.
# CONV_EVAL_MAX_CASES_PER_RUN=100
# Per-criterion pass bar (0-1; default 0.7).
# CONV_EVAL_MIN_SCORE=0.7
# Judge provider: deepseek (default, background policy) | anthropic (Haiku opt-in).
# CONV_EVAL_JUDGE_PROVIDER=deepseek
# Optional explicit judge model (e.g. claude-haiku-4-5 or claude-sonnet-5-5).
# CONV_EVAL_JUDGE_MODEL=
# Healing kill switch (prompt-level hints only; code fixes stay proposals).
# CONV_EVAL_HEAL_ENABLED=off
# Heal attempts per tick. 0 = heal EVERY failed case. Default 10.
# CONV_EVAL_MAX_PATCHES_PER_RUN=10
# Active prompt-rule cap; the OLDEST rules retire (deactivated, audited) first.
# 0 = unlimited. Default 30.
# CONV_EVAL_MAX_ACTIVE_RULES=30
# Borderline re-judge: a narrow miss (within this margin of the bar) gets ONE
# extra judge call so provider variance cannot flip a good reply. 0 = off.
# CONV_EVAL_REJUDGE_MARGIN=0.10
# Extra judge calls allowed per tick for borderline cases. 0 = off. Default 5.
# CONV_EVAL_REJUDGE_MAX=5
# The ONLY eval email: one detailed summary every N hours, plus ONE WhatsApp
# ping when it is sent. Heals themselves never notify. 0 = off. Default 6.
# CONV_EVAL_DIGEST_HOURS=6

# Per-user context cache: engine facts are cached when a conversation starts and
# reused for this many minutes (0 = always rebuild). Default 5 — the window is a
# safety net for a missed invalidation, not the design: every user-data write
# invalidates through src/services/afterWrite.js.
# USER_CONTEXT_CACHE_TTL_MINUTES=5
# Skip transcripts already evaluated within this window (0.25-168 h; default 1).
# CONV_EVAL_DEDUPE_HOURS=1

# v1.61.15 — eval SPEND controls (call-based and deterministic; 0 = unlimited/off).
# Max judge calls per tick, borderline re-judges included. Default 24.
# CONV_EVAL_MAX_JUDGE_CALLS_PER_TICK=24
# A case with N consecutive passes rests for R ticks before re-checking; live
# and calibration cases never rest. Defaults 3 and 5.
# CONV_EVAL_PASS_STREAK=3
# CONV_EVAL_PASS_REST_TICKS=5
# Deterministic-lane churn guard: after N ab_gate refusals inside the cooldown
# window, heals for that case stop (the digest still flags a code fix). 0 = off.
# CONV_EVAL_MAX_REFUSALS_PER_CASE=3
# CONV_EVAL_REFUSAL_COOLDOWN_HOURS=24
# Soft daily WhatsApp alert when eval calls cross this threshold (never stops).
# EVAL_DAILY_CALL_ALERT=1500

# ============================================================
# RUNTIME TUNING (optional; code defaults shown)
# ============================================================
# MESSAGE_MAX_CONCURRENCY=8
# DELIVERY_BLOCK_HOURS=24
# MESSAGE_MAX_ATTEMPTS=3
# MESSAGE_RETRY_BASE_MS=250
# SUPABASE_TIMEOUT_MS=15000
# SAKA_PROMPT_CACHE_MS=60000

# Conversation freshness (v1.32.3) - stale state must never hijack a turn.
# Chat turns older than this window are never injected into the model prompt.
# CHAT_HISTORY_MAX_AGE_MINUTES=45
# CHAT_HISTORY_MAX_MESSAGES=40
# Re-engagement memory (v1.59.4) - when the fresh window is empty (a returning
# user), the last few messages (any age up to MAX_AGE_DAYS) ride the prompt as
# LABELLED context, never as live turns. Bounded and secret-scrubbed.
# CHAT_REENGAGE_MAX_MESSAGES=6
# CHAT_REENGAGE_MAX_AGE_DAYS=14
# CHAT_REENGAGE_MAX_CHARS=900
# Inline report PDF (v1.77.0) - the WhatsApp report lane answers with the
# dashboard link instantly and, while this budget lasts (ms, clamped 0-8000),
# also builds + links the PDF in the same reply. 0 = dashboard link only.
# REPORT_INLINE_BUILD_MS=4000
# An untouched quiz draft expires after this many minutes (clamped 5-240).
# QUIZ_MAX_AGE_MINUTES=20
# Fuel economy (v1.17.1): full-to-full segment floor, plausibility cap and
# metric rating thresholds (km/L). Exact economy is only computed between
# full-tank fills; top-ups are folded into the segment denominator.
# FUEL_ECON_MIN_SEGMENT_KM=20
# FUEL_ECON_MAX_PLAUSIBLE_KML=80
# FUEL_RATING_GOOD_KML=10
# FUEL_RATING_EXCELLENT_KML=14

# ============================================================
# TRIAL
# ============================================================
TRIAL_DAYS=30
TRIAL_MAX_TOTAL_DAYS=45
TRIAL_CONVERSION_LADDER=on
TRIAL_ACTIVATION_COUPON_PCT=20

# Startup WhatsApp announcement (v1.23.2) - opt-in only (default off).
# STARTUP_ANNOUNCE=off

# Incident registry (v1.23.3): recurrences before a resolved issue re-opens.
# INCIDENT_REOPEN_THRESHOLD=3
# --- v1.24.0 conversation-first intake ---
# UPLOAD_HINTS_ENABLED=off
# INSTANT_ACK_ENABLED=on
# INSTANT_ACK_CHARS=180
# NATURAL_INTAKE=on
# --- v1.34.0 narrative intake ---
# NARRATIVE_INTAKE: on|off -> deterministic pre-parsing of pasted free-text
# records (money, volume, odometer, vendor, retro date). Default on.
# NARRATIVE_INTAKE=on
# --- v1.24.1 reply-speed telemetry ---
# TURN_LATENCY_LOGGING_ENABLED=on
# TURN_LATENCY_MAX_ROWS=10000
# TURN_LATENCY_TRIM_EVERY=250
# --- v1.24.2 slow-turn ack ---
# SLOW_ACK_MS=4000

# --- v1.28.0 contact-save nudge ---
# Days before the one-time save-my-number suggestion may repeat for a profile.
# CONTACT_NUDGE_COOLDOWN_DAYS=30



# --- v1.28.2 Anthropic thinking budget ---
# Extended thinking shares the max_tokens budget and truncated WhatsApp replies.
# Leave off unless a deliberate reasoning purpose needs it. The live gateway
# turns thinking off with "between_tools" (it rejects "disabled" with HTTP 400).
# ANTHROPIC_THINKING_ENABLED=off
# ANTHROPIC_THINKING_MODE=between_tools

# ============================================================
# v1.32.4 — ENV PARITY (knobs the code reads; documented here so
# `npm run env:audit` and `npm run health` stay green)
# ============================================================

# ---- SHORT-LINK PROBE (v1.32.4) ----
# The app asks itself whether the branded base really serves /r/<code> before
# it sends a short link. `off` trusts SHORT_LINK_DOMAIN_READY/PUBLIC_APP_URL
# without a network round-trip (offline suites and self-monitored bases).
# SHORT_LINK_PROBE=on
# Verdict cache (ms, min 60000) and probe timeout (ms, max 15000).
# SHORT_LINK_PROBE_CACHE_MS=600000
# SHORT_LINK_PROBE_TIMEOUT_MS=3000

# ---- SENTINEL STALL WATCHDOG ----
# A draft untouched for this many minutes is nudged, then released.
# SENTINEL_STALL_MINUTES=45
# SENTINEL_STALL_INTERVAL_MS=300000
# Maximum nudges per stalled conversation before the quiz is parked.
# SENTINEL_MAX_NUDGES=2

# ---- REMEDIATION TUNING (Rule 15–19; REMEDIATION_AUTONOMY stays off) ----
# REMEDIATION_SCAN_INTERVAL_MS=60000
# REMEDIATION_SYNTHESIS_INTERVAL_MS=900000
# REMEDIATION_AUDIT_WINDOW_HOURS=4
# REMEDIATION_PLAN_TRIGGER_COUNT=3
# REMEDIATION_PLAN_COOLDOWN_MS=21600000
# REMEDIATION_MAX_PLANS_PER_DAY=4
# REMEDIATION_MAX_ATTEMPTS=2
# REMEDIATION_NONCE_TTL_HOURS=24
# REMEDIATION_EXECUTION_RETRY_MS=1800000
# REMEDIATION_DISPATCH_TIMEOUT_MS=15000
# REMEDIATION_URGENT_PENDING_THRESHOLD=10   # urgent page fires at this many PENDING proposals (v1.58.13)
# REMEDIATION_URGENT_ERROR_THRESHOLD=10     # deprecated alias read as a fallback
# REMEDIATION_URGENT_COOLDOWN_MS=1800000
# Digest cadence (hours CSV) auto-scales daily then weekly.
# REMEDIATION_DIGEST_HOURS_CSV=8,20
# REMEDIATION_DIGEST_DAILY_THRESHOLD=6
# REMEDIATION_DIGEST_WEEKLY_THRESHOLD=2
# REMEDIATION_DIGEST_SCALE_DOWN_WINDOW_DAYS=7
# Local directory the CI work order is written to.
# REMEDIATION_WORK_ORDER_DIR=tmp/remediation

# ---- HOT-PATH CACHES ----
# QUIZ_QUESTION_CACHE_MS=900000
# QUIZ_QUESTION_CACHE_MAX=300
# ACTION_DISCOVERY_CACHE_MS=300000
# ACTION_DISCOVERY_CACHE_MAX=200
# COMPLIANCE_CATALOG_CACHE_MS=600000
# Prompt-refinement guard: refuse refinements larger than this.
# SAKA_MAX_PROMPT_REFINEMENT_CHARS=4000

# ---- ADMIN / TELEMETRY PAGING ----
# AUDIT_LIMIT=200
# AI_USAGE_PAGE_SIZE=1000
# TURN_LATENCY_PAGE_SIZE=1000

# ---- VIN LEDGER LEGACY COMPAT ----
# Read legacy per-VIN trial columns only when explicitly enabled.
# LEGACY_VIN_TRIALS=off

# ---- LEDGER & CONFIG HYGIENE (v1.72.x, Phase 8) ----
# P2-3: the legacy `expenses` mirror write. `expense_logs` is the canonical
# ledger; true keeps today's dual-write, false stops the mirror so `expenses`
# becomes a read-only archival table. Set false after the v1.73.0 read
# migrations are proven in production.
# LEGACY_EXPENSES_WRITE_ENABLED=true
# P2-6: system_config keys are namespaced (e.g. `prompt.saka_core_prompt`).
# `dual` reads/writes BOTH the namespaced and legacy key for one release
# (rolling-deploy safe); set to `new` in v1.73.0 after the migration has run
# and a full cycle proved the dual window.
# SYSTEM_CONFIG_KEY_MODE=dual

