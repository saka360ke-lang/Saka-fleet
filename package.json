{
  "name": "sakafleet-backend",
  "type": "module",
  "version": "1.0.0",
  "description": "Saka Fleet Backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node scripts/run_tests.js",
    "test:cleanup": "node scripts/run_tests.js --cleanup-only",
    "health": "node --env-file=.env scripts/health_audit.js",
    "check:supabase": "node scripts/check_supabase_connection.js",
    "audit:logs": "node scripts/audit_logs.js",
    "reset:db": "node scripts/reset-db.js",
    "reset:slate": "node scripts/reset_db_slate.js",
    "migrate:vin": "node scripts/run_vin_immutability_migration.js",
    "migrate:subscriptions": "node scripts/run_subscription_migration.js",
    "migrate:trial-unbind": "node scripts/run_trial_unbind_migration.js",
    "migrate:driver-profile": "node scripts/run_driver_profile_migration.js",
    "migrate:vehicle-compliance": "node scripts/run_vehicle_compliance_migration.js",
    "migrate:followups": "node scripts/run_followups_migration.js",
    "migrate:dunning": "node scripts/run_dunning_migration.js",
    "migrate:welcome-trial": "node scripts/run_welcome_trial_migration.js",
    "migrate:remediation": "node scripts/run_remediation_migration.js",
    "migrate:model-registry": "node scripts/run_model_registry_migration.js",
    "migrate:fuel-fill": "node scripts/run_fuel_fill_type_migration.js",
    "migrate:report-grants": "node scripts/run_driver_report_grants_migration.js",
    "migrate:receipts": "node scripts/run_receipts_migration.js",
    "migrate:feature-notice": "node scripts/run_feature_notice_migration.js",
    "rollout:features": "node scripts/feature_rollout.js",
    "test:anthropic": "node scripts/test_anthropic_connection.js",
    "model:scout": "node scripts/model_scout.js",
    "remediation:ci": "node scripts/remediation_ci.js",
    "migrate:staging-schema": "node scripts/provision_staging_schema.js",
    "migrate:sessions": "node scripts/run_chat_sessions_migration.js",
    "notify:deploy": "node scripts/notify_git_push.js",
    "postinstall": "node scripts/notify_git_push.js || true"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@google-cloud/logging": "^12.3.0",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "openai": "^7.45.1",
    "pdfkit": "^0.20.2",
    "resend": "^6.34.1"
  }
}
